{
  "name": "cypressautomation",
  "version": "1.0.0",
  "description": "Pruebas automatizadas con cypress+pom+cucumber",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "validate:steps": "node scripts/validate-steps.js",
    "validate:branch": "node scripts/validate-branch-name.js",
    "test:all": "cypress run",
    "test:smoke": "cypress run --env tags=@smoke",
    "test:regression": "cypress run --env tags=@regression",
    "test:login": "cypress run --spec cypress/e2e/features/sauceLogin.feature",
    "test:inventory": "cypress run --spec cypress/e2e/features/sauceInventory.feature",
    "test:cart": "cypress run --spec cypress/e2e/features/sauceCart.feature",
    "report:cucumber": "node scripts/generate-cucumber-report.js"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.{js,jsx,ts,tsx}"
    ],
    "filterSpecs": true,
    "omitFiltered": true,
    "json": {
      "enabled": true,
      "output": "reports/cucumber-json/cucumber-report.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderTincopa/CypressAutomation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AlexanderTincopa/CypressAutomation/issues"
  },
  "homepage": "https://github.com/AlexanderTincopa/CypressAutomation#readme",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^25.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "cypress": "^15.17.0",
    "husky": "^9.1.7",
    "multiple-cucumber-html-reporter": "^3.9.3"
  }
}
